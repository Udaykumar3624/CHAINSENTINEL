# ChainSentinel (SIH26146) Environment Configuration Template
# Copy this file to .env and replace placeholders with production values.

# System & API Metadata
PROJECT_NAME="ChainSentinel"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL or fallback SQLite)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/chainsentinel"

# Security & JWT Configuration (DO NOT COMMIT SECRETS TO GIT)
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Seeded Demo Investigator Account
DEMO_USERNAME="demo.investigator"
DEMO_PASSWORD="your-strong-investigator-password-here"
DEMO_EMAIL="demo@chainsentinel.local"
DEMO_FULL_NAME="Lead Investigator"

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend API URL Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# MempoolSpace Live Blockchain Data Configuration
LIVE_DATA_ENABLED=false
MEMPOOL_API_URL="https://mempool.space/api"
REQUEST_TIMEOUT_SECONDS=10
