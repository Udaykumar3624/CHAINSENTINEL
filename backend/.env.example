# ChainSentinel Backend Environment Variables Template
ENVIRONMENT=production
DATABASE_URL=sqlite:///./chainsentinel.db
# Generate a secure 32+ char secret in production, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600
CORS_ORIGINS=https://chainsentinel-5pns.vercel.app,http://localhost:5173
LIVE_DATA_ENABLED=false
MEMPOOL_API_URL=https://mempool.space/api
